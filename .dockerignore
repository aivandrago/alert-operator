# More info: https://docs.docker.com/engine/reference/builder/#dockerignore-file
# Ignore everything by default and re-include only needed files
**

# Re-include Go source files (but not *_test.go). The source directories are re-included by
# name as well: Podman and Docker's legacy builder do not descend into an ignored directory to
# find **/*.go. See https://github.com/containers/buildah/issues/6417
!api
!cmd
!internal
!**/*.go
**/*_test.go

# Re-include Go module files
!go.mod
!go.sum

# The binaries the release workflow cross-compiles for Dockerfile.release.
!dist/manager-linux-*
